<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Hostinger may deploy the repo root as public_html. Route web traffic into Laravel's public directory.
    RewriteRule ^(\.env|composer\.(json|lock)|package(-lock)?\.json)$ - [F,L]
    RewriteRule ^backend-laravel/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Serve static portal apps before Laravel so Hostinger does not expose physical directories.
    RewriteRule ^(admin|student|teacher|hrm|brandmanager|accounting)/?$ backend-laravel/public/$1/index.html [L]

    RewriteCond %{DOCUMENT_ROOT}/backend-laravel/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/backend-laravel/public/$1 -d
    RewriteRule ^((admin|student|teacher|hrm|brandmanager|accounting)(/.*)?)$ backend-laravel/public/$1 [L]

    RewriteCond %{REQUEST_URI} !\.[^/]+$
    RewriteRule ^(admin|student|teacher|hrm|brandmanager|accounting)(/.*)?$ backend-laravel/public/$1/index.html [L]

    RewriteCond %{DOCUMENT_ROOT}/backend-laravel/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/backend-laravel/public/$1 -d
    RewriteRule ^(.*)$ backend-laravel/public/$1 [L]

    RewriteRule ^ backend-laravel/public/index.php [L]
</IfModule>
